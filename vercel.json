{
  "buildCommand": "npm run build && npm run api:build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/about.html", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/menu", "destination": "/index.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/gallery", "destination": "/index.html" },
    { "source": "/reservation", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
